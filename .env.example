# Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Uses SQLite by default if DATABASE_URL starts with sqlite: or if not postgres.
# For SQLite: sqlite:./musiq.db
# For PostgreSQL: postgresql://user:password@localhost:5432/musiq
DATABASE_URL=sqlite:./musiq.db

# Authentication
JWT_SECRET=super-secret-musiq-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# YouTube Data API v3 Key
# Obtain from Google Cloud Console (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
